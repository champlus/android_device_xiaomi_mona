From c3029a50bcb2ce5d0ec52d2e7382fc9bd6728836 Mon Sep 17 00:00:00 2001
From: Xiaomi Civi Port <mona-port@lineageos.local>
Date: Mon, 23 Nov 2026 14:00:13 +0800
Subject: [PATCH 1/3] techpack: display: Support restoring 12-bit reg 0x51 on
 LHBM off-to-normal

Panels such as Xiaomi Civi (mona, k9b) use 12-bit brightness (0..4095,
0x0FFF) and include a 0x51 brightness command (initialized to 0x0000)
inside mi,mdss-dsi-local-hbm-off-to-normal-command, advertising its
command index via mi,local-hbm-off-to-normal-51-index.

1. Parse mi,local-hbm-off-to-normal-51-index (defaulting to -1 so panels
   that omit it remain unaffected) and patch register 0x51 with
   real_bl_level before sending DSI_CMD_SET_MI_LOCAL_HBM_OFF_TO_NORMAL so
   exiting optical UDFPS LHBM preserves the active display brightness.
2. Widen the reg 0x51 high-byte mask in dsi_panel_update_cmd_reg51() from
   & 0x07 (11-bit) to & 0x0f (12-bit) and validate tx_len >= 3 so 12-bit
   panels like k9b do not wrap modulo 2048 (writing 51 00 00 at 50%
   brightness) while remaining regression-safe for 11-bit panels.
---
 techpack/display/msm/dsi/dsi_panel.c | 19 ++++++++++++++++---
 techpack/display/msm/dsi/dsi_panel.h |  1 +
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/techpack/display/msm/dsi/dsi_panel.c b/techpack/display/msm/dsi/dsi_panel.c
index a6dce7a..4f92c1b 100644
--- a/techpack/display/msm/dsi/dsi_panel.c
+++ b/techpack/display/msm/dsi/dsi_panel.c
@@ -725,6 +725,9 @@ static int dsi_panel_update_cmd_reg51(struct dsi_panel *panel, enum dsi_cmd_set_
 	case DSI_CMD_SET_MI_LOCAL_HBM_NORMAL_WHITE_1000NIT:
 		index = panel->local_hbm_on_1000nit_51_index;
 		break;
+	case DSI_CMD_SET_MI_LOCAL_HBM_OFF_TO_NORMAL:
+		index = panel->local_hbm_off_to_normal_51_index;
+		break;
 	default:
 		DSI_ERR("wrong cmd type!\n");
 		return -EINVAL;
@@ -743,8 +746,8 @@ static int dsi_panel_update_cmd_reg51(struct dsi_panel *panel, enum dsi_cmd_set_
 	}
 
 	tx_buf = (u8 *)cmds[index].msg.tx_buf;
-	if (!tx_buf) {
-		DSI_ERR("cmd %d tx_buf is null\n", type);
+	if (!tx_buf || cmds[index].msg.tx_len < 3) {
+		DSI_ERR("cmd %d tx_buf is null or too short\n", type);
 		return -EINVAL;
 	}
 
@@ -753,7 +756,7 @@ static int dsi_panel_update_cmd_reg51(struct dsi_panel *panel, enum dsi_cmd_set_
 		return -EINVAL;
 	}
 
-	tx_buf[1] = (bl_lvl >> 8) & 0x07;
+	tx_buf[1] = (bl_lvl >> 8) & 0x0f;
 	tx_buf[2] = bl_lvl & 0xff;
 
 	return 0;
@@ -790,6 +793,10 @@ static int dsi_panel_set_fod_hbm(struct dsi_panel *panel, bool status)
 				DSI_ERR("[%s] failed to send doze local hbm off cmd, rc=%d\n",
 						panel->name, rc);
 		} else {
+			if (panel->local_hbm_off_to_normal_51_index >= 0)
+				dsi_panel_update_cmd_reg51(panel,
+							   DSI_CMD_SET_MI_LOCAL_HBM_OFF_TO_NORMAL,
+							   panel->bl_config.real_bl_level);
 			rc = dsi_panel_tx_cmd_set(panel, DSI_CMD_SET_MI_LOCAL_HBM_OFF_TO_NORMAL);
 			if (rc)
 				DSI_ERR("[%s] failed to send local hbm off cmd, rc=%d\n",
@@ -3707,6 +3714,12 @@ static int dsi_panel_parse_fod(struct dsi_panel *panel)
 	if (rc)
 		DSI_INFO("mi,local-hbm-on-1000nit-51-index not specified\n");
 
+	panel->local_hbm_off_to_normal_51_index = -1;
+	rc = utils->read_u32(utils->data, "mi,local-hbm-off-to-normal-51-index",
+			     &panel->local_hbm_off_to_normal_51_index);
+	if (rc)
+		DSI_INFO("mi,local-hbm-off-to-normal-51-index not specified\n");
+
 	return 0;
 }
 
diff --git a/techpack/display/msm/dsi/dsi_panel.h b/techpack/display/msm/dsi/dsi_panel.h
index 8523bff..bec5519 100644
--- a/techpack/display/msm/dsi/dsi_panel.h
+++ b/techpack/display/msm/dsi/dsi_panel.h
@@ -285,6 +285,7 @@ struct dsi_panel {
 	bool fod_hbm_requested;
 	bool fod_ui;
 	int local_hbm_on_1000nit_51_index;
+	int local_hbm_off_to_normal_51_index;
 };
 
 static inline bool dsi_panel_ulps_feature_enabled(struct dsi_panel *panel)
