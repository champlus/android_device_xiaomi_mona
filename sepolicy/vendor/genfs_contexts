# Front dual soft-light flash & rear flash LEDs (PM8350C @ 0xee00)
genfscon sysfs /devices/platform/soc/c440000.qcom,spmi/spmi-0/spmi0-02/c440000.qcom,spmi:qcom,pm8350c@2:qcom,flash_led@ee00/leds u:object_r:sysfs_leds:s0

# Dual Awinic AW882xx stereo Smart PA calibration node
genfscon sysfs /class/smartpa/re25_calib u:object_r:vendor_sysfs_smartpa:s0

# Optical UDFPS touch sysfs nodes (prevents ueventd coldboot race on late sysfs_create_group)
genfscon sysfs /devices/virtual/touch/touch_dev/fod_longpress_gesture_enabled u:object_r:vendor_sysfs_udfps:s0
genfscon sysfs /devices/virtual/touch/touch_dev/fod_finger_down u:object_r:vendor_sysfs_udfps:s0
